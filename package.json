{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": { "bun": "1.4.3" },
  "scripts": {
    "dev": "bun run anatomy:build && bun ./node_modules/vite/bin/vite.js",
    "build": "bun run anatomy:build && bun ./node_modules/vite/bin/vite.js build",
    "anatomy:build": "bun scripts/anatomy/build.mjs",
    "anatomy:audit": "bun scripts/anatomy/build.mjs --audit",
    "typecheck": "bun ./node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json && bun ./node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.node.json",
    "preview": "bun ./node_modules/vite/bin/vite.js preview",
    "lint": "bun ./node_modules/eslint/bin/eslint.js . --report-unused-disable-directives --max-warnings 0",
    "test": "bun test --watch",
    "test:run": "bun test",
    "test:coverage": "bun test --coverage",
    "check": "bun run typecheck && bun run lint && bun run test:coverage && bun run build"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "motion": "14.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-aria-components": "1.22.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@happy-dom/global-registrator": "20.14.6",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
